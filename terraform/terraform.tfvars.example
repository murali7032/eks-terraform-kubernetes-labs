# elasticsearch_allowed_cidr    = "YOUR.PUBLIC.IP.ADDRESS/32"
# elasticsearch_key_name        = "YOUR_EXISTING_EC2_KEY_PAIR"
# s3_test_bucket_name           = "YOUR_EXISTING_DISPOSABLE_BUCKET"

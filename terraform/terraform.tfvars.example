aws_region  = "ap-south-1"
aws_profile = "default"
# Required: uncomment and replace with your current public IP. Find it from a trusted source.
# cluster_endpoint_allowed_cidrs = ["YOUR.PUBLIC.IP/32"]

# Optional labs (leave disabled until you are ready to run them):
